# Copy this file to ".env" next to ThermalDesignAgent.exe
# (or to %LOCALAPPDATA%\ThermalDesignAgent\.env) and fill in your values.

# Offline mode: deterministic calculations and CAD work, AI features disabled.
LLM_PROVIDER=mock

# Azure OpenAI mode: set LLM_PROVIDER=azure and fill in the values below.
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_VERSION=2025-03-01-preview
# AZURE_OPENAI_DEPLOYMENT=
